# A — Simulator container (one Unity Linux binary per container)
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    xvfb \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libvulkan1 \
    libgomp1 \
    libx11-6 \
    libxext6 \
    libxrender1 \
    libglu1-mesa \
    mesa-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY docker/entrypoint-sim.sh /app/docker/entrypoint-sim.sh
RUN chmod +x /app/docker/entrypoint-sim.sh

# Binary is expected via volume mount at runtime:
#   AICAR_SIMULATOR_PATH=/app/simulator/AutoDRIVE Simulator.x86_64
ENV AICAR_SIMULATOR_PATH=/app/simulator/AutoDRIVE Simulator.x86_64
ENV BRAIN_HOST=brain
ENV BASE_PORT=4567

ENTRYPOINT ["/app/docker/entrypoint-sim.sh"]
